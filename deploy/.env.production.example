# Production env for docker-compose.prod.yml. Copy to .env.production on the server (never commit it).
# deploy/deploy.sh generates this automatically with random secrets on first deploy.

DOMAIN=taskline.sugunajayaram.tech
# Let's Encrypt account email — only used by the bundled Caddy (COMPOSE_PROFILES=caddy).
# With an existing Traefik, certificates come from Traefik's own resolver.
ACME_EMAIL=you@example.com

POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate-a-random-value
POSTGRES_DB=taskline

# >= 32 chars, random:  openssl rand -hex 32
SECRET_KEY=generate-a-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true

# Optional: Google sign-in. Add https://<DOMAIN>/api/v1/auth/google/callback as an
# authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: AI features (Plan with AI, status reports). Leave the key empty to disable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_DAILY_LIMIT=30
