# Copy to .env and fill in real values. NEVER commit .env.

# --- Postgres (used by docker compose) ---
POSTGRES_USER=postgres
# Required by docker-compose.yml (compose refuses to start without it). Use a strong random value.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskline

# --- Backend ---
# Local (non-Docker) connection string; docker compose overrides this to point at the `db` service.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/taskline
# REQUIRED: at least 32 characters and not a placeholder — the backend refuses to start otherwise.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
#                or:  openssl rand -base64 48
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO
# Rate limiting on auth endpoints (login/register/refresh/OAuth). Keep enabled outside of tests.
RATE_LIMIT_ENABLED=true

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- URLs / CORS ---
# Where OAuth redirects back to, and which browser origins may call the API.
# Leave commented to use per-stack defaults: docker-compose.yml -> http://localhost:3000,
# docker-compose.dev.yml / local `npm run dev` -> http://localhost:5173.
# FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
# Baked into the bundle at build time.
VITE_API_URL=http://localhost:8000
# Backend origin allowed by the nginx Content-Security-Policy (connect-src) in the Docker image.
# Defaults to VITE_API_URL in docker-compose.yml; set explicitly if they differ (scheme://host[:port], no path).
API_ORIGIN=http://localhost:8000
